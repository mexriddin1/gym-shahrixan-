# Firebase web app config (Project settings > Your apps > SDK setup and configuration).
# These are inlined into the client bundle at build time, so they are public by design.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional — only needed for Google Analytics.
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Set to true to point the app at the local emulator suite.
NEXT_PUBLIC_FIREBASE_EMULATOR=
